# ---- Mode ----------------------------------------------------------------
# offline : no API key needed. Text-layer extractor, template drafts, template NL queries.
#           Works on digital PDFs; scans go to human review (fails loud, by design).
# llm     : vision LLM extraction + LLM drafting + text-to-SQL. Needs a provider key below.
NOVA_MODE=offline
EXTRACTOR_MODEL=gemini/gemini-3.8-flash
FALLBACK_MODEL=gemini/gemini-3.1-pro-preview
TEXT_MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=

# ---- Guardrails -------------------------------------------------------------
BUDGET_USD_PER_DOC=0.05
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
MAX_PAGES=5

# ---- Observability (optional) ----------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
